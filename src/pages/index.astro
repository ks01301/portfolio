---
import Base from '../layouts/Base.astro';
import Architecture from '../components/Architecture.astro';
import Featured from '../components/Featured.astro';
import ProjectFolders from '../components/ProjectFolders.astro';
import { profile, focus, experience, skillGroups, levels, projects, timeline } from '../data/site';

const levelLabel = (id: string) => levels.find((l) => l.id === id)?.label ?? '';
---

<Base>
  <main id="main">
    <div class="wrap">
      <section class="hero">
        <div>
          <h1 aria-label={`${profile.titleTop} ${profile.titleBottom}`}>
            <span aria-hidden="true">{profile.titleTop}</span>
            <span class="ol" aria-hidden="true">{profile.titleBottom}</span>
          </h1>
          <p class="hero-hi">{profile.greeting}</p>
          <p class="hero-lead">{profile.intro}</p>
          <div class="hero-acts">
            <a class="btn btn-pri" href="#career">경력 보기</a>
            <a class="btn" href="#contact">연락하기</a>
          </div>
        </div>
        <div class="stack">
          <div class="pc pc-resume" aria-hidden="true">
            <b>경력 {profile.careerYears}</b>{profile.name}
            <i style="width:82%"></i><i style="width:60%"></i><i style="width:74%"></i><i style="width:48%"></i>
          </div>
          <div class="pc pc-term" aria-hidden="true">
            {`Kubernetes, Talos
control-plane  5
worker         5`}
          </div>
          <div class="pc pc-state">
            <b><span class="lamp" aria-hidden="true"></span>Proxmox 클러스터</b>
            <p>서버 5대, VM 27대를 서비스, 사내, Kubernetes 영역으로 나눠 구성했습니다.</p>
            <a href="#infra">인프라 구성도 보기</a>
          </div>
        </div>
      </section>

      <section class="focus" aria-label="하는 일">
        {
          focus.map((f) => (
            <article>
              <h2>{f.title}</h2>
              <p>{f.body}</p>
              <a href={f.href}>{f.link}</a>
            </article>
          ))
        }
      </section>

      <section class="sec" id="infra">
        <div class="sh">
          <small>인프라 구성도</small>
          <h2>직접 구성한 가상화 환경입니다.</h2>
          <p>칸 하나가 VM 한 대입니다. 묶음을 누르면 설명이 나옵니다. 실제 서버 이름은 공개하지 않았습니다.</p>
        </div>
        <Architecture />
      </section>

      <section class="sec" id="career">
        <div class="sh">
          <small>경력 {profile.careerYears}</small>
          <h2>서버와 네트워크, 웹 서비스를<br />맡아 왔습니다.</h2>
        </div>
        <div class="tl">
          {
            experience.map((j) => (
              <article class="job">
                <h3>
                  {j.company}
                  <span class="badge">{j.badge}</span>
                </h3>
                <p class="job-team">{j.team}</p>
                <time>{j.period}</time>
                <p class="job-summary">{j.summary}</p>
                <details open={j.open}>
                  <summary>주요 업무 보기</summary>
                  <ul class="dots">
                    {j.work.map((w) => (
                      <li>{w}</li>
                    ))}
                  </ul>
                </details>
                <ul class="chips">
                  {j.stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>
    </div>

    <section class="band" id="skills">
      <div class="wrap">
        <div class="sh">
          <small>기술</small>
          <h2>분야별로 어디까지 해 봤는지 나눴습니다.</h2>
          <p>기술을 누르면 어디에 썼는지 나옵니다.</p>
        </div>
        <div class="legend" id="sk-filter" role="group" aria-label="숙련도로 걸러 보기">
          {
            levels.map((l) => (
              <button type="button" data-filter={l.id} aria-pressed="false">
                <i style={`background:${l.id === 'run' ? 'var(--fill)' : 'var(--sysbg)'}`} />
                {l.label}
              </button>
            ))
          }
        </div>
        <div class="skills" id="sk-list">
          {
            skillGroups.map((g) => (
              <div class="sk-row">
                <div>
                  <b>{g.name}</b>
                  <span class="d">{g.desc}</span>
                </div>
                <div class="sk-list">
                  {g.skills.map((s) => (
                    <button
                      type="button"
                      class="sk"
                      data-level={s.level}
                      data-name={s.name}
                      data-label={levelLabel(s.level)}
                      data-used={s.used ?? ''}
                      data-project={s.project ?? ''}
                      aria-pressed="false"
                    >
                      {s.name}
                      <span class="sr">({levelLabel(s.level)})</span>
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="sk-detail" id="sk-detail" aria-live="polite">기술을 하나 눌러 보세요.</div>
      </div>
    </section>

    <div class="wrap">
      <section class="sec" id="projects">
        <div class="sh">
          <small>프로젝트</small>
          <h2>직접 맡아서 만든 것들입니다.</h2>
          <p>폴더를 열고 파일을 누르면 해당 프로젝트로 이동합니다. HA 카드의 버튼은 동작을 보여 주는 예시입니다.</p>
        </div>
        <ProjectFolders />
        <Featured />
        <div class="cards">
          {
            projects.map((p) => (
              <article class="card" id={`project-${p.id}`}>
                <div class="prev">
                  <div class="win">
                    <header>
                      <span>{p.win}</span>
                      {p.demo === 'ha' && <button class="mini" type="button" id="run-ha">서버 1 내리기</button>}
                    </header>
                    <div class="win-body" aria-live="polite">
                      {p.demo === 'list' && p.lines.map((l) => <div>{l}</div>)}
                      {p.demo === 'ha' && (
                        <>
                          <div class="step" data-ha="1"><span>{p.lines[0]}</span><span>활성</span></div>
                          <div class="step is-wait" data-ha="2"><span>{p.lines[1]}</span><span>대기</span></div>
                          <div class="win-result" id="ha-result">서비스는 서버 1에서 실행 중입니다.</div>
                        </>
                      )}
                    </div>
                  </div>
                </div>
                <h3>{p.title}</h3>
                <p class="card-summary">{p.summary}</p>
                <ul class="chips">
                  {p.stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="sec" id="history">
        <div class="sh">
          <small>소개</small>
          <h2>학력과 자격증</h2>
        </div>
        <div class="ab">
          <ol class="hist">
            {
              timeline.map((t) => (
                <li>
                  <time>{t.when}</time>
                  <span>
                    {t.what}
                    <small>{t.where}</small>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
    </div>

    <section class="con" id="contact">
      <div class="wrap">
        <h2>궁금한 점이 있으면 메일 주세요</h2>
        <div class="con-acts">
          <button class="btn" type="button" data-copy>이메일 주소 복사</button>
        </div>
        <p class="con-mail">{profile.email}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { profile } from '../data/site';

  const $ = (id: string) => document.getElementById(id)!;

  // 이메일 복사
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const original = b.textContent!;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(profile.email);
        b.textContent = '복사했습니다';
      } catch {
        b.textContent = '주소를 직접 선택해 주세요';
      }
      setTimeout(() => (b.textContent = original), 1800);
    });
  });

  // 기술 필터와 설명
  const skills = [...document.querySelectorAll<HTMLButtonElement>('.sk')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('#sk-filter button')];
  for (const b of filters) {
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      filters.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));
      skills.forEach((s) => s.classList.toggle('is-dim', on && s.dataset.level !== b.dataset.filter));
    });
  }
  for (const b of skills) {
    b.addEventListener('click', () => {
      skills.forEach((s) => s.setAttribute('aria-pressed', String(s === b)));
      const { name, label, used, project } = b.dataset;
      $('sk-detail').innerHTML = `<b>${name}</b>, ${label}. ${used ? `${used}.` : ''}${project ? ` <a href="#project-${project}">프로젝트 보기</a>` : ''}`;
    });
  }

  // HA 동작 예시
  let serverOneUp = true;
  const runHa = $('run-ha');
  const haRow = (n: string) => document.querySelector<HTMLElement>(`[data-ha="${n}"]`)!;
  runHa.addEventListener('click', () => {
    serverOneUp = !serverOneUp;
    const one = haRow('1');
    const two = haRow('2');
    one.lastElementChild!.textContent = serverOneUp ? '활성' : '중단';
    one.classList.toggle('is-wait', !serverOneUp);
    two.lastElementChild!.textContent = serverOneUp ? '대기' : '활성';
    two.classList.toggle('is-wait', serverOneUp);
    $('ha-result').textContent = serverOneUp ? '서비스는 서버 1에서 실행 중입니다.' : '서비스가 서버 2로 넘어갔습니다.';
    runHa.textContent = serverOneUp ? '서버 1 내리기' : '서버 1 올리기';
  });
</script>
