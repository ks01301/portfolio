---
import Base from '../layouts/Base.astro';
import Topology from '../components/Topology.astro';
import { profile, experience, projects, incidents, skillGroups, levels, timeline } from '../data/site';
---

<Base>
  <header class="top">
    <div class="wrap top-inner">
      <a class="top-name" href="#main">{profile.name}</a>
      <nav aria-label="섹션">
        <a href="#experience">경력</a>
        <a href="#projects">프로젝트</a>
        <a href="#incidents">트러블슈팅</a>
        <a href="#skills">기술</a>
        <a href="#history">학력</a>
        <a href="#contact">연락</a>
      </nav>
      <button class="theme" id="theme" type="button" aria-label="어두운 화면으로 전환">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="hero wrap">
      <h1>{profile.headline}</h1>
      <p class="hero-intro">{profile.intro}</p>
      <Topology />
    </section>

    <section class="block wrap" id="experience" aria-labelledby="experience-h">
      <div class="block-head">
        <h2 id="experience-h">경력</h2>
      </div>
      <ol class="jobs">
        {
          experience.map((e) => (
            <li class="job">
              <div class="job-head">
                <h3>{e.company}</h3>
                <span class="job-role">{e.role}</span>
                <span class="job-period">{e.period}</span>
              </div>
              <p class="job-summary">{e.summary}</p>
              <ul class="bullets">
                {e.work.map((w) => (
                  <li>{w}</li>
                ))}
              </ul>
              <p class="job-stack">{e.stack.join(', ')}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block wrap" id="projects" aria-labelledby="projects-h">
      <div class="block-head">
        <h2 id="projects-h">프로젝트</h2>
        <p>제목을 누르면 문제와 한 일, 결과가 펼쳐집니다.</p>
      </div>
      <div class="rows">
        {
          projects.map((p) => (
            <details class="row" id={`project-${p.id}`}>
              <summary>
                <span class="row-title">{p.title}</span>
                <span class="row-summary">{p.summary}</span>
                <span class="row-meta">{p.period}</span>
                <span class="row-mark" aria-hidden="true" />
              </summary>
              <div class="row-body">
                <dl>
                  <dt>문제</dt>
                  <dd>{p.problem}</dd>
                  <dt>한 일</dt>
                  <dd>
                    <ul class="bullets">
                      {p.work.map((w) => (
                        <li>{w}</li>
                      ))}
                    </ul>
                  </dd>
                  <dt>결과</dt>
                  <dd>{p.result}</dd>
                  <dt>사용 기술</dt>
                  <dd>{p.stack.join(', ')}</dd>
                </dl>
                <a href={p.link} target="_blank" rel="noreferrer">
                  저장소 보기
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="block wrap" id="incidents" aria-labelledby="incidents-h">
      <div class="block-head">
        <h2 id="incidents-h">트러블슈팅 기록</h2>
        <p>직접 겪은 장애와 다시 일어나지 않도록 바꾼 것들입니다.</p>
      </div>
      <div class="rows">
        {
          incidents.map((i) => (
            <details class="row">
              <summary>
                <span class="row-title">{i.title}</span>
                <span class="row-summary">{i.duration}</span>
                <span class="row-meta">{i.date}</span>
                <span class="row-mark" aria-hidden="true" />
              </summary>
              <div class="row-body">
                <dl>
                  <dt>원인</dt>
                  <dd>{i.cause}</dd>
                  <dt>조치</dt>
                  <dd>{i.fix}</dd>
                  <dt>재발 방지</dt>
                  <dd>{i.prevent}</dd>
                </dl>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="block wrap" id="skills" aria-labelledby="skills-h">
      <div class="block-head">
        <h2 id="skills-h">기술</h2>
        <p>숙련도를 고르면 해당하는 기술만 남습니다.</p>
        <div class="filters" role="group" aria-label="숙련도로 걸러 보기">
          {
            levels.map((l) => (
              <button type="button" class="filter" data-level={l.id} aria-pressed="false">
                <span class="dot" data-level={l.id} aria-hidden="true" />
                {l.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="skills" id="skill-list">
        {
          skillGroups.map((g) => (
            <div class="skill-group">
              <h3>{g.name}</h3>
              <ul>
                {g.skills.map((s) => (
                  <li data-level={s.level}>
                    <span class="dot" data-level={s.level} aria-hidden="true" />
                    {s.name}
                    <span class="sr">({levels.find((l) => l.id === s.level)?.label})</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="block wrap" id="history" aria-labelledby="history-h">
      <div class="block-head">
        <h2 id="history-h">학력과 자격증</h2>
      </div>
      <ol class="timeline">
        {
          timeline.map((t) => (
            <li>
              <time>{t.when}</time>
              <span class="timeline-what">{t.what}</span>
              <span class="timeline-where">{t.where}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="contact wrap" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">같이 일할 팀을 찾고 있습니다</h2>
      <p>메일을 주시면 하루 안에 답장합니다.</p>
      <div class="contact-actions">
        <button class="btn btn-solid" id="copy-email" type="button" data-email={profile.email}>이메일 주소 복사</button>
        <a class="btn" href={profile.resume}>이력서 PDF 받기</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={profile.blog} target="_blank" rel="noreferrer">블로그</a>
      </div>
      <p class="contact-email">{profile.email}</p>
    </section>
  </main>

  <footer class="wrap foot">
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>
</Base>

<script>
  const root = document.documentElement;

  // 화면 모드
  const themeBtn = document.getElementById('theme')!;
  const label = () =>
    themeBtn.setAttribute('aria-label', root.dataset.theme === 'dark' ? '밝은 화면으로 전환' : '어두운 화면으로 전환');
  label();
  themeBtn.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    label();
  });

  // 기술 필터
  const list = document.getElementById('skill-list')!;
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  for (const btn of filters) {
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      filters.forEach((b) => b.setAttribute('aria-pressed', String(on && b === btn)));
      if (on) list.dataset.filter = btn.dataset.level;
      else delete list.dataset.filter;
    });
  }

  // 이메일 복사
  const copy = document.getElementById('copy-email') as HTMLButtonElement;
  const original = copy.textContent!;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.email!);
      copy.textContent = '복사했습니다';
    } catch {
      copy.textContent = '복사하지 못했습니다. 아래 주소를 직접 선택해 주세요';
    }
    setTimeout(() => (copy.textContent = original), 2200);
  });

  // 주소에 #project-…가 붙어 들어오면 해당 항목을 펼친다
  const openFromHash = () => {
    const el = location.hash ? document.querySelector(location.hash) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
</script>

<style>
  .wrap {
    width: 100%;
    max-width: calc(var(--page) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── 상단 ── */
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .top-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }

  .top-name {
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .top nav {
    display: flex;
    gap: clamp(14px, 2.4vw, 28px);
    margin-left: auto;
    font-size: 0.9375rem;
  }

  .top nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .top nav a:hover {
    color: var(--ink);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .theme:hover {
    background: var(--line);
  }

  /* ── 첫 화면 ── */
  .hero {
    padding-top: clamp(48px, 9vw, 104px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .hero h1 {
    max-width: 14em;
    font-size: clamp(2.25rem, 6.2vw, 4.5rem);
    font-weight: 750;
    line-height: 1.14;
    letter-spacing: -0.035em;
  }

  .hero-intro {
    max-width: 38em;
    margin-top: 24px;
    margin-bottom: clamp(36px, 5vw, 56px);
    font-size: 1.125rem;
    color: var(--muted);
  }

  /* ── 섹션 공통 ── */
  .block {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 24px 56px;
    padding-block: clamp(48px, 7vw, 88px);
    border-top: 1px solid var(--line);
  }

  .block-head {
    align-self: start;
    position: sticky;
    top: 92px;
  }

  .block-head h2 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .block-head p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* ── 경력 ── */
  .jobs {
    border-top: 1.5px solid var(--ink);
  }

  .job {
    padding: 24px 4px 28px;
    border-bottom: 1px solid var(--line);
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
  }

  .job-head h3 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .job-role {
    font-weight: 600;
  }

  .job-period {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .job-summary {
    max-width: 44em;
    margin-top: 6px;
    margin-bottom: 14px;
    color: var(--muted);
  }

  .job .bullets {
    max-width: 44em;
  }

  .job-stack {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* ── 펼치는 행 ── */
  .rows {
    border-top: 1.5px solid var(--ink);
  }

  .row {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 80px;
  }

  .row summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 20px;
    grid-template-areas:
      'title meta mark'
      'summary summary .';
    gap: 4px 20px;
    align-items: baseline;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
  }

  .row summary::-webkit-details-marker {
    display: none;
  }

  .row-title {
    grid-area: title;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .row summary:hover .row-title {
    color: var(--accent);
  }

  .row-summary {
    grid-area: summary;
    color: var(--muted);
  }

  .row-meta {
    grid-area: meta;
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .row-mark {
    grid-area: mark;
    align-self: center;
    position: relative;
    width: 14px;
    height: 14px;
    justify-self: end;
  }

  .row-mark::before,
  .row-mark::after {
    content: '';
    position: absolute;
    inset: 6px 0 auto;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s;
  }

  .row-mark::after {
    transform: rotate(90deg);
  }

  .row[open] .row-mark::after {
    transform: rotate(0deg);
  }

  .row-body {
    padding: 4px 4px 28px;
  }

  .row-body dl {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 12px 20px;
    max-width: 44em;
  }

  .row-body dt {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
    padding-top: 0.08em;
  }

  .row-body > a {
    display: inline-block;
    margin-top: 18px;
    margin-left: 108px;
    font-weight: 600;
  }

  .bullets li {
    position: relative;
    padding-left: 16px;
  }

  .bullets li + li {
    margin-top: 4px;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 6px;
    height: 2px;
    background: var(--muted);
  }

  /* ── 기술 ── */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .filter:hover {
    border-color: var(--muted);
  }

  .filter[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid currentColor;
  }

  .dot[data-level='run'] {
    background: currentColor;
  }

  .dot[data-level='used'] {
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 36px 32px;
  }

  .skill-group h3 {
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .skill-group li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    transition: opacity 0.2s;
  }

  .skill-group .dot {
    color: var(--accent);
  }

  .skills[data-filter='run'] li:not([data-level='run']),
  .skills[data-filter='used'] li:not([data-level='used']),
  .skills[data-filter='learning'] li:not([data-level='learning']) {
    opacity: 0.22;
  }

  /* ── 이력 ── */
  .timeline {
    border-top: 1.5px solid var(--ink);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: 4px 20px;
    align-items: baseline;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
  }

  .timeline time,
  .timeline-where {
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .timeline-what {
    font-weight: 600;
  }

  /* ── 연락 ── */
  .contact {
    padding-block: clamp(64px, 10vw, 128px);
    border-top: 1px solid var(--line);
  }

  .contact h2 {
    max-width: 14em;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 750;
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .contact > p {
    max-width: 36em;
    margin-top: 20px;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 32px;
  }

  .contact > .contact-email {
    margin-top: 16px;
    font-size: 0.9375rem;
    user-select: all;
  }

  .foot {
    padding-block: 28px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (max-width: 880px) {
    .block {
      grid-template-columns: minmax(0, 1fr);
    }

    .block-head {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .top nav a:nth-child(n + 4) {
      display: none;
    }

    .job-period {
      margin-left: 0;
      flex-basis: 100%;
    }

    .row summary {
      grid-template-areas:
        'title mark'
        'summary .'
        'meta .';
      grid-template-columns: minmax(0, 1fr) 20px;
    }

    .row-body dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .row-body dd + dt {
      margin-top: 14px;
    }

    .row-body > a {
      margin-left: 0;
    }

    .timeline li {
      grid-template-columns: 76px minmax(0, 1fr);
    }

    .timeline-where {
      grid-column: 2;
    }
  }
</style>
