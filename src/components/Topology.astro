---
import { nodes } from '../data/site';

const W = 150;
const H = 58;
const at = (id: string) => nodes.find((n) => n.id === id)!;

const traffic = [
  ['user', 'edge'],
  ['edge', 'lb'],
  ['lb', 'app1'],
  ['lb', 'app2'],
];
const dbLinks = [
  ['app1', 'dbp'],
  ['app2', 'dbp'],
  ['app1', 'dbr'],
  ['app2', 'dbr'],
];
const control = [
  ['ci', 'app1'],
  ['ci', 'app2'],
  ['mon', 'app2'],
  ['mon', 'dbr'],
  ['dbp', 'dbr'],
];
---

<div class="topo" id="topo">
  <div class="topo-status" data-health="ok">
    <span class="topo-lamp" aria-hidden="true"></span>
    <p class="topo-state" role="status"><strong id="topo-state">전체 정상</strong></p>
    <p class="topo-detail" id="topo-detail">요청이 두 앱 인스턴스로 번갈아 전달됩니다.</p>
    <p class="topo-count" id="topo-count"></p>
    <button class="topo-reset" id="topo-reset" type="button" hidden>전체 복구</button>
  </div>

  <div class="topo-body">
    <div class="topo-scroll">
      <svg viewBox="0 0 900 390" role="group" aria-label="서비스 구성도. 노드를 선택하면 설명이 표시됩니다.">
        <g class="topo-edges">
          {
            control.map(([a, b]) => (
              <line class="topo-edge is-control" data-a={a} data-b={b} x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
            ))
          }
          {
            traffic.map(([a, b]) => (
              <line class="topo-edge" data-a={a} data-b={b} x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
            ))
          }
          {
            dbLinks.map(([a, b]) => (
              <line class="topo-edge is-db" data-a={a} data-b={b} x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
            ))
          }
        </g>
        <g id="topo-packets"></g>
        <g class="topo-nodes">
          {
            nodes.map((n) => (
              <g
                class="topo-node"
                data-id={n.id}
                transform={`translate(${n.x - W / 2} ${n.y - H / 2})`}
                tabindex="0"
                role="button"
                aria-label={`${n.label}, ${n.sub}`}
              >
                <rect width={W} height={H} rx="12" />
                <text class="topo-label" x="14" y="25">
                  {n.label}
                </text>
                <text class="topo-sub" x="14" y="43" data-sub>
                  {n.sub}
                </text>
                {n.killable && <circle class="topo-pip" cx={W - 15} cy="16" r="4" />}
              </g>
            ))
          }
        </g>
      </svg>
    </div>

    <aside class="topo-panel" id="topo-panel" aria-live="polite">
      <h3>구성도 사용법</h3>
      <p>노드를 누르면 그 계층에서 한 일이 여기에 나타납니다.</p>
    </aside>
  </div>
</div>

<script>
  import { nodes } from '../data/site';

  const SVG = 'http://www.w3.org/2000/svg';
  const root = document.getElementById('topo')!;
  const packetLayer = document.getElementById('topo-packets')!;
  const panel = document.getElementById('topo-panel')!;
  const statusBox = root.querySelector<HTMLElement>('.topo-status')!;
  const stateEl = document.getElementById('topo-state')!;
  const detailEl = document.getElementById('topo-detail')!;
  const countEl = document.getElementById('topo-count')!;
  const resetBtn = document.getElementById('topo-reset') as HTMLButtonElement;

  const byId = new Map(nodes.map((n) => [n.id, n]));
  const nodeEls = new Map<string, SVGGElement>();
  root.querySelectorAll<SVGGElement>('.topo-node').forEach((el) => nodeEls.set(el.dataset.id!, el));
  const edgeEls = [...root.querySelectorAll<SVGLineElement>('.topo-edge')];

  const down = new Set<string>();
  const other = (db: string) => (db === 'dbp' ? 'dbr' : 'dbp');
  let writer = 'dbp';
  let promoting: number | undefined;
  let selected = 'lb';
  let turn = 0;
  const recent: boolean[] = [];

  // 요청 하나가 지나갈 경로. 막히면 마지막 노드에서 실패한다.
  function plan() {
    const path = ['user', 'edge', 'lb'];
    if (down.has('lb')) return { path, ok: false };
    const apps = ['app1', 'app2'].filter((id) => !down.has(id));
    if (!apps.length) return { path, ok: false };
    path.push(apps[turn++ % apps.length]);
    if (down.has(writer)) return { path, ok: false };
    path.push(writer);
    return { path, ok: true };
  }

  function health(): [string, string, string] {
    if (down.has('lb')) return ['down', '서비스 중단', 'Ingress가 내려가 요청을 받을 수 없습니다.'];
    if (down.has('app1') && down.has('app2'))
      return ['down', '서비스 중단', '살아 있는 앱 인스턴스가 없어 503을 반환합니다.'];
    if (down.has(writer)) {
      return down.has(other(writer))
        ? ['down', '서비스 중단', 'DB가 모두 내려가 요청을 처리할 수 없습니다.']
        : ['warn', '장애 조치 중', 'primary가 응답하지 않아 replica를 승격하고 있습니다.'];
    }
    if (down.size) return ['warn', '일부 중단, 서비스 정상', '남은 노드가 모든 요청을 처리하고 있습니다.'];
    return ['ok', '전체 정상', '요청이 두 앱 인스턴스로 번갈아 전달됩니다.'];
  }

  function failover() {
    const needed = down.has(writer) && !down.has(other(writer));
    if (!needed) {
      clearTimeout(promoting);
      promoting = undefined;
      return;
    }
    if (promoting) return;
    promoting = window.setTimeout(() => {
      promoting = undefined;
      writer = other(writer);
      render();
    }, 1800);
  }

  function renderPanel() {
    const n = byId.get(selected)!;
    const isDown = down.has(n.id);
    const role = n.id === 'dbp' || n.id === 'dbr' ? (n.id === writer ? ' (primary)' : ' (replica)') : '';
    panel.innerHTML = `
      <h3>${n.title}${role}</h3>
      <p>${n.body}</p>
      <ul class="topo-tools">${n.tools.map((t) => `<li>${t}</li>`).join('')}</ul>
      <div class="topo-actions">
        ${
          n.killable
            ? `<button type="button" class="btn ${isDown ? 'btn-solid' : ''}" data-toggle="${n.id}">${
                isDown ? '다시 올리기' : '이 노드 내리기'
              }</button>`
            : ''
        }
        ${n.project ? `<a href="#project-${n.project}" data-project="${n.project}">관련 프로젝트 보기</a>` : ''}
      </div>`;
  }

  function render() {
    for (const [id, el] of nodeEls) {
      el.classList.toggle('is-down', down.has(id));
      el.classList.toggle('is-selected', id === selected);
      el.setAttribute('aria-pressed', String(id === selected));
      if (id === 'dbp' || id === 'dbr') {
        const role = id === writer ? 'primary' : 'replica';
        el.querySelector('[data-sub]')!.textContent = `PostgreSQL ${role}`;
        el.setAttribute('aria-label', `${byId.get(id)!.label}, PostgreSQL ${role}${down.has(id) ? ', 중단됨' : ''}`);
      } else {
        const n = byId.get(id)!;
        el.setAttribute('aria-label', `${n.label}, ${n.sub}${down.has(id) ? ', 중단됨' : ''}`);
      }
    }
    for (const el of edgeEls) {
      const { a, b } = el.dataset;
      el.classList.toggle('is-dead', down.has(a!) || down.has(b!));
      if (el.classList.contains('is-db')) el.classList.toggle('is-idle', b !== writer);
    }
    const [level, state, detail] = health();
    statusBox.dataset.health = level;
    stateEl.textContent = state;
    detailEl.textContent = detail;
    resetBtn.hidden = down.size === 0;
    renderPanel();
  }

  function toggle(id: string) {
    if (down.has(id)) down.delete(id);
    else down.add(id);
    failover();
    render();
  }

  for (const [id, el] of nodeEls) {
    const select = () => {
      selected = id;
      render();
    };
    el.addEventListener('click', select);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        select();
      }
    });
  }

  panel.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const id = target.closest<HTMLElement>('[data-toggle]')?.dataset.toggle;
    if (id) {
      toggle(id);
      panel.querySelector<HTMLElement>('[data-toggle]')?.focus();
    }
    const project = target.closest<HTMLElement>('[data-project]')?.dataset.project;
    if (project) document.getElementById(`project-${project}`)?.setAttribute('open', '');
  });

  resetBtn.addEventListener('click', () => {
    down.clear();
    failover();
    render();
  });

  // ── 요청 애니메이션 ──
  type Packet = { el: SVGCircleElement; pts: [number, number][]; lens: number[]; total: number; d: number; ok: boolean; end: string };
  const packets: Packet[] = [];
  const SPEED = 300;
  const EVERY = 0.38;

  function spawn() {
    const { path, ok } = plan();
    const pts = path.map((id) => [byId.get(id)!.x, byId.get(id)!.y] as [number, number]);
    const lens = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
    const el = document.createElementNS(SVG, 'circle');
    el.setAttribute('r', '4.5');
    el.setAttribute('class', 'topo-packet');
    packetLayer.append(el);
    packets.push({ el, pts, lens, total: lens.reduce((a, b) => a + b, 0), d: 0, ok, end: path[path.length - 1] });
  }

  function finish(p: Packet) {
    p.el.remove();
    recent.push(p.ok);
    if (recent.length > 40) recent.shift();
    countEl.textContent = `최근 요청 ${recent.length}건 중 ${recent.filter(Boolean).length}건 성공`;
    if (!p.ok) {
      const el = nodeEls.get(p.end)!;
      el.classList.add('is-hit');
      setTimeout(() => el.classList.remove('is-hit'), 260);
    }
  }

  let last = 0;
  let since = 0;
  function frame(now: number) {
    const dt = Math.min((now - last) / 1000 || 0, 0.05);
    last = now;
    since += dt;
    if (since >= EVERY) {
      since = 0;
      spawn();
    }
    for (let i = packets.length - 1; i >= 0; i--) {
      const p = packets[i];
      p.d += SPEED * dt;
      if (p.d >= p.total) {
        finish(p);
        packets.splice(i, 1);
        continue;
      }
      let rest = p.d;
      let s = 0;
      while (rest > p.lens[s]) rest -= p.lens[s++];
      const k = rest / p.lens[s];
      p.el.setAttribute('cx', String(p.pts[s][0] + (p.pts[s + 1][0] - p.pts[s][0]) * k));
      p.el.setAttribute('cy', String(p.pts[s][1] + (p.pts[s + 1][1] - p.pts[s][1]) * k));
    }
    requestAnimationFrame(frame);
  }

  render();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(frame);
</script>

<style is:global>
  .topo {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }

  .topo-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    --lamp: var(--ok);
  }

  .topo-status[data-health='warn'] {
    --lamp: var(--warn);
  }

  .topo-status[data-health='down'] {
    --lamp: var(--down);
  }

  .topo-lamp {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lamp);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--lamp) 22%, transparent);
    transition: background-color 0.2s;
  }

  .topo-state strong {
    font-weight: 700;
  }

  .topo-detail {
    color: var(--muted);
  }

  .topo-count {
    margin-left: auto;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .topo-reset {
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .topo-reset:hover {
    border-color: var(--ink);
  }

  .topo-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  .topo-scroll {
    overflow-x: auto;
    padding: 18px 14px;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: 11px 11px;
  }

  .topo-scroll svg {
    display: block;
    width: 100%;
    min-width: 720px;
    height: auto;
    font-family: var(--font);
  }

  .topo-edge {
    stroke: var(--line);
    stroke-width: 2;
    transition: opacity 0.2s;
  }

  .topo-edge.is-control {
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    stroke-linecap: round;
  }

  .topo-edge.is-idle {
    opacity: 0;
  }

  .topo-edge.is-dead {
    opacity: 0.35;
  }

  .topo-edge.is-idle.is-dead {
    opacity: 0;
  }

  .topo-packet {
    fill: var(--accent);
  }

  .topo-node {
    cursor: pointer;
    outline: none;
  }

  .topo-node rect {
    fill: var(--paper);
    stroke: var(--line);
    stroke-width: 1.5;
    transition:
      stroke 0.15s,
      fill 0.15s;
  }

  .topo-node:hover rect {
    stroke: var(--muted);
  }

  .topo-node.is-selected rect {
    stroke: var(--accent);
    stroke-width: 2.5;
    fill: var(--accent-soft);
  }

  .topo-node:focus-visible rect {
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: none;
  }

  .topo-node.is-down rect {
    stroke-dasharray: 5 5;
    fill: var(--surface);
  }

  .topo-node.is-hit rect {
    stroke: var(--down);
  }

  .topo-label {
    fill: var(--ink);
    font-size: 15px;
    font-weight: 650;
  }

  .topo-sub {
    fill: var(--muted);
    font-size: 12px;
  }

  .topo-node.is-down .topo-label {
    fill: var(--muted);
    text-decoration: line-through;
  }

  .topo-pip {
    fill: var(--ok);
  }

  .topo-node.is-down .topo-pip {
    fill: var(--down);
  }

  .topo-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 22px;
    border-left: 1px solid var(--line);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .topo-panel h3 {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .topo-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .topo-tools li {
    padding: 2px 10px;
    border-radius: 6px;
    background: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .topo-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: auto;
    padding-top: 8px;
  }

  @media (max-width: 1040px) {
    .topo-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .topo-panel {
      border-left: 0;
      border-top: 1px solid var(--line);
      min-height: 250px;
    }

    .topo-count {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
