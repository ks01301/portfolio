---
import { nodes } from '../data/site';

const W = 150;
const H = 58;
const at = (id: string) => nodes.find((n) => n.id === id)!;

const traffic = [
  ['user', 'edge'],
  ['edge', 'lb'],
  ['lb', 'app1'],
  ['lb', 'app2'],
];
const dbLinks = [
  ['app1', 'dbp'],
  ['app2', 'dbp'],
  ['app1', 'dbr'],
  ['app2', 'dbr'],
];
const control = [
  ['ci', 'app1'],
  ['ci', 'app2'],
  ['mon', 'app2'],
  ['mon', 'dbr'],
  ['dbp', 'dbr'],
];
---

<div class="tile" id="topo-box">
  <div class="bar" role="status">
    <span class="lamp" aria-hidden="true"></span>
    <strong id="topo-state">전체 정상</strong>
    <span class="bar-detail" id="topo-detail">요청이 두 앱 인스턴스로 번갈아 전달됩니다.</span>
    <span class="bar-count" id="topo-count"></span>
  </div>
  <div class="stage">
    <svg id="topo-svg" viewBox="0 0 900 390" role="group" aria-label="서비스 구성도. 노드를 선택하면 설명이 표시됩니다.">
      <g>
        {
          control.map(([a, b]) => (
            <line class="e e-control" data-a={a} data-b={b} x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
          ))
        }
        {
          traffic.map(([a, b]) => (
            <line class="e" data-a={a} data-b={b} x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
          ))
        }
        {
          dbLinks.map(([a, b]) => (
            <line class="e" data-db data-a={a} data-b={b} x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
          ))
        }
      </g>
      <g id="topo-packets"></g>
      <g>
        {
          nodes.map((n) => (
            <g
              class="n"
              data-id={n.id}
              transform={`translate(${n.x - W / 2} ${n.y - H / 2})`}
              tabindex="0"
              role="button"
              aria-label={`${n.label}, ${n.sub}`}
            >
              <rect width={W} height={H} rx="6" />
              <text class="n-label" x="14" y="25">
                {n.label}
              </text>
              <text class="n-sub" x="14" y="43" data-sub>
                {n.sub}
              </text>
              {n.killable && <circle class="pip" cx={W - 15} cy="16" r="4" />}
            </g>
          ))
        }
      </g>
    </svg>
  </div>
  <div class="panel" id="topo-panel" aria-live="polite"></div>
</div>

<script>
  import { nodes } from '../data/site';

  const SVG = 'http://www.w3.org/2000/svg';
  const W = 150;
  const H = 58;
  const root = document.documentElement;
  const svg = document.getElementById('topo-svg')!;
  const packetLayer = document.getElementById('topo-packets')!;
  const panel = document.getElementById('topo-panel')!;
  const stateEls = [document.getElementById('topo-state')!, document.getElementById('hero-state')].filter(Boolean) as HTMLElement[];
  const detailEls = [document.getElementById('topo-detail')!, document.getElementById('hero-detail')].filter(Boolean) as HTMLElement[];
  const countEl = document.getElementById('topo-count')!;

  const byId = new Map(nodes.map((n) => [n.id, n]));
  const nodeEls = new Map<string, SVGGElement>();
  svg.querySelectorAll<SVGGElement>('.n').forEach((el) => nodeEls.set(el.dataset.id!, el));
  const edgeEls = [...svg.querySelectorAll<SVGLineElement>('.e')];

  const down = new Set<string>();
  const other = (db: string) => (db === 'dbp' ? 'dbr' : 'dbp');
  let writer = 'dbp';
  let promoting: number | undefined;
  let selected = 'lb';
  let turn = 0;
  const recent: boolean[] = [];

  // 휴대폰에서는 세로 배치 좌표를 쓴다
  const narrow = matchMedia('(max-width: 620px)');
  const pos = (id: string): [number, number] => {
    const n = byId.get(id)!;
    return narrow.matches ? [n.mx, n.my] : [n.x, n.y];
  };
  function layout() {
    svg.setAttribute('viewBox', narrow.matches ? '0 0 360 480' : '0 0 900 390');
    for (const [id, el] of nodeEls) {
      const [x, y] = pos(id);
      el.setAttribute('transform', `translate(${x - W / 2} ${y - H / 2})`);
    }
    for (const el of edgeEls) {
      const a = pos(el.dataset.a!);
      const b = pos(el.dataset.b!);
      el.setAttribute('x1', String(a[0]));
      el.setAttribute('y1', String(a[1]));
      el.setAttribute('x2', String(b[0]));
      el.setAttribute('y2', String(b[1]));
    }
  }
  narrow.addEventListener('change', layout);

  // 요청 하나가 지나갈 경로. 막히면 마지막 노드에서 실패한다.
  function plan() {
    const path = ['user', 'edge', 'lb'];
    if (down.has('lb')) return { path, ok: false };
    const apps = ['app1', 'app2'].filter((id) => !down.has(id));
    if (!apps.length) return { path, ok: false };
    path.push(apps[turn++ % apps.length]);
    if (down.has(writer)) return { path, ok: false };
    path.push(writer);
    return { path, ok: true };
  }

  function health(): [string, string, string] {
    if (down.has('lb')) return ['down', '서비스 중단', 'Ingress가 내려가 요청을 받을 수 없습니다.'];
    if (down.has('app1') && down.has('app2'))
      return ['down', '서비스 중단', '살아 있는 앱 인스턴스가 없어 503을 반환합니다.'];
    if (down.has(writer)) {
      return down.has(other(writer))
        ? ['down', '서비스 중단', 'DB가 모두 내려가 요청을 처리할 수 없습니다.']
        : ['warn', '장애 조치 중', 'primary가 응답하지 않아 replica를 승격하고 있습니다.'];
    }
    if (down.size) return ['warn', '일부 중단, 서비스 정상', '남은 노드가 모든 요청을 처리하고 있습니다.'];
    return ['ok', '전체 정상', '요청이 두 앱 인스턴스로 번갈아 전달됩니다.'];
  }

  function failover() {
    const needed = down.has(writer) && !down.has(other(writer));
    if (!needed) {
      clearTimeout(promoting);
      promoting = undefined;
      return;
    }
    if (promoting) return;
    promoting = window.setTimeout(() => {
      promoting = undefined;
      writer = other(writer);
      render();
    }, 1800);
  }

  function renderPanel() {
    const n = byId.get(selected)!;
    const isDown = down.has(n.id);
    const role = n.id === 'dbp' || n.id === 'dbr' ? (n.id === writer ? ' (primary)' : ' (replica)') : '';
    panel.innerHTML = `
      <div>
        <h3>${n.title}${role}</h3>
        <p>${n.body}</p>
        <ul class="panel-tools">${n.tools.map((t) => `<li>${t}</li>`).join('')}</ul>
        ${n.project ? `<a class="panel-link" href="#project-${n.project}">관련 프로젝트 보기</a>` : ''}
      </div>
      <div class="panel-acts">
        ${
          n.killable
            ? `<button type="button" class="btn btn-sm ${isDown ? '' : 'btn-pri'}" data-toggle="${n.id}">${
                isDown ? '다시 올리기' : '이 노드 내리기'
              }</button>`
            : ''
        }
        ${down.size ? '<button type="button" class="btn btn-sm" data-reset>전체 복구</button>' : ''}
      </div>`;
  }

  function render() {
    for (const [id, el] of nodeEls) {
      el.classList.toggle('is-down', down.has(id));
      el.classList.toggle('is-selected', id === selected);
      el.setAttribute('aria-pressed', String(id === selected));
      if (id === 'dbp' || id === 'dbr') {
        const role = id === writer ? 'primary' : 'replica';
        el.querySelector('[data-sub]')!.textContent = `PostgreSQL ${role}`;
        el.setAttribute('aria-label', `${byId.get(id)!.label}, PostgreSQL ${role}${down.has(id) ? ', 중단됨' : ''}`);
      } else {
        const n = byId.get(id)!;
        el.setAttribute('aria-label', `${n.label}, ${n.sub}${down.has(id) ? ', 중단됨' : ''}`);
      }
    }
    for (const el of edgeEls) {
      const { a, b } = el.dataset;
      el.classList.toggle('is-dead', down.has(a!) || down.has(b!));
      if ('db' in el.dataset) el.classList.toggle('is-idle', b !== writer);
    }
    const [level, state, detail] = health();
    root.dataset.health = level;
    stateEls.forEach((e) => (e.textContent = state));
    detailEls.forEach((e) => (e.textContent = detail));
    renderPanel();
  }

  for (const [id, el] of nodeEls) {
    const select = () => {
      selected = id;
      render();
    };
    el.addEventListener('click', select);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        select();
      }
    });
  }

  panel.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const id = target.closest<HTMLElement>('[data-toggle]')?.dataset.toggle;
    if (id) {
      if (down.has(id)) down.delete(id);
      else down.add(id);
      failover();
      render();
      panel.querySelector<HTMLElement>('[data-toggle]')?.focus();
    }
    if (target.closest('[data-reset]')) {
      down.clear();
      failover();
      render();
    }
  });

  // ── 요청 애니메이션 ──
  type Packet = { el: SVGCircleElement; pts: [number, number][]; lens: number[]; total: number; d: number; ok: boolean; end: string };
  const packets: Packet[] = [];
  const SPEED = 300;
  const EVERY = 0.38;

  function spawn() {
    const { path, ok } = plan();
    const pts = path.map(pos);
    const lens = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
    const el = document.createElementNS(SVG, 'circle');
    el.setAttribute('r', '4.5');
    el.setAttribute('class', 'pkt');
    packetLayer.append(el);
    packets.push({ el, pts, lens, total: lens.reduce((a, b) => a + b, 0), d: 0, ok, end: path[path.length - 1] });
  }

  function finish(p: Packet) {
    p.el.remove();
    recent.push(p.ok);
    if (recent.length > 40) recent.shift();
    countEl.textContent = `최근 요청 ${recent.length}건 중 ${recent.filter(Boolean).length}건 성공`;
    if (!p.ok) {
      const el = nodeEls.get(p.end)!;
      el.classList.add('is-hit');
      setTimeout(() => el.classList.remove('is-hit'), 170);
    }
  }

  let last = 0;
  let since = 0;
  function frame(now: number) {
    const dt = Math.min((now - last) / 1000 || 0, 0.05);
    last = now;
    since += dt;
    if (since >= EVERY) {
      since = 0;
      spawn();
    }
    for (let i = packets.length - 1; i >= 0; i--) {
      const p = packets[i];
      p.d += SPEED * dt;
      if (p.d >= p.total) {
        finish(p);
        packets.splice(i, 1);
        continue;
      }
      let rest = p.d;
      let s = 0;
      while (rest > p.lens[s]) rest -= p.lens[s++];
      const k = rest / p.lens[s];
      p.el.setAttribute('cx', String(p.pts[s][0] + (p.pts[s + 1][0] - p.pts[s][0]) * k));
      p.el.setAttribute('cy', String(p.pts[s][1] + (p.pts[s + 1][1] - p.pts[s][1]) * k));
    }
    requestAnimationFrame(frame);
  }

  layout();
  render();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(frame);
</script>
